[Unit]
Description=nvoy status page collector (status S1): writes waggle.nave.pub/status
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
Environment=PATH=/usr/local/bin:/usr/bin:/bin
StateDirectory=nvoy-status
StateDirectoryMode=0700
# Host stage: container state, logs, channel processes, uptime and the deploy record, root-only.
ExecStart=/bin/sh /opt/nvoy-hub/deploy/nvoy-status-facts.sh /var/lib/nvoy-status/facts
# Judging stage: the deployed runtime image, read-only, every capability dropped, no Docker socket and
# no credentials mounted. It reads the facts and the manifests and writes only the page directory
# Caddy serves as /srv/apps/status.
ExecStart=/bin/sh -c 'exec docker run --rm --read-only --tmpfs /tmp --cap-drop ALL --security-opt no-new-privileges -u 0:0 \
  -v /var/lib/nvoy-status/facts:/facts:ro -v /var/lib/nvoy-status/state:/state \
  -v /etc/nvoy/instances:/etc/nvoy/instances:ro -v /root/nave.pub/deploy/sites/status:/out \
  --entrypoint node "$(cat /var/lib/nvoy-deploy/DEPLOYED_RUNTIME_IMAGE)" \
  /srv/nvoy/mcp/tools/nvoy-status.mjs --facts /facts --state /state --out /out --instances /etc/nvoy/instances'
TimeoutStartSec=120
